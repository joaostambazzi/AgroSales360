    <decisions>
        <name>Check_Credit_Inputs_Changed</name>
        <label>Check Credit Inputs Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Recalculate_Credit_Analysis</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payment_Term__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Payment_Term</targetReference>
            </connector>
            <label>Recalculate Credit Analysis</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Credit_Limit</name>
        <label>Check Credit Limit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Credit_Analysis_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Term__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>À vista</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Credit_Status_Not_Required</targetReference>
            </connector>
            <label>No Credit Analysis Required</label>
        </rules>
        <rules>
            <name>Within_Credit_Limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Term__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>À vista</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CalculatedFinalAmount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Opportunity_Account.Cr_dito_Dispon_vel_Calculado__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Credit_Status_Within_Limit</targetReference>
            </connector>
            <label>Within Credit Limit</label>
        </rules>
        <rules>
            <name>Above_Credit_Limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Term__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>À vista</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CalculatedFinalAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Opportunity_Account.Cr_dito_Dispon_vel_Calculado__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Credit_Status_Pending_Finance</targetReference>
            </connector>
            <label>Above Credit Limit</label>
        </rules>
    </decisions>
