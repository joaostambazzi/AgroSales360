<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_6_Months_Without_Purchase</name>
        <label>Check 6 Months Without Purchase</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X6_Months_Without_Purchase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ativo</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Last_Purchase_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Last_Purchase_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>SixMonthsAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Reactivation_Task</targetReference>
            </connector>
            <label>6 Months Without Purchase</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Existing_Reactivation_Task</name>
        <label>Check Existing Reactivation Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Open_Reactivation_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Reactivation_Task.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reactivation_Task</targetReference>
            </connector>
            <label>No Open Reactivation Task</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ReactivationTaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <formulas>
        <name>SixMonthsAgo</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(), -6)</expression>
    </formulas>
    <interviewLabel>Account 6 Months Without Purchase {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account 6 Months Without Purchase</label>
    <processMetadataValues>
